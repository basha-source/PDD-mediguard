# ── BACKEND (apps/backend/.env) ──────────────────────────
# These NEVER go to client — backend only

# Firebase Admin SDK service account JSON (single line)
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_MAPS_API_KEY=
PORT=4000

# Shared secret for POST /api/notifications/scan-missed (the missed-dose scan).
# Any non-empty string; must match whatever the caller sends as x-cron-secret.
CRON_SECRET=dev-cron-secret

# Fallback IANA zone for patients whose user doc has no `timezone` yet.
# medicine.schedule times are wall-clock in the patient's zone, not UTC.
DEFAULT_TIMEZONE=Asia/Kolkata

# ── ML SERVICE (apps/ml-service) ─────────────────────────
# Selects the /ocr backend only — /ask always uses the ML service.
# "ml"     = our own ML service (default) — no API keys needed
# Local: http://localhost:8000 — deployed: https://<user>-mediguard-ml.hf.space
ML_SERVICE_URL=http://localhost:8000

