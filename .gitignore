# ── Dependencies ─────────────────────────────────────────
node_modules/

# ── Environment variables — NEVER commit these ───────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.test
.env*.local
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.staging
**/.env.test

# ── Build outputs ─────────────────────────────────────────
dist/
build/
.expo/
.turbo/

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────
.vscode/
.idea/

# ── Local tooling / agent scratch (never commit) ─────────
.claude/
.qodo/
.tools/
generate-icons.ps1

# ── Expo / React Native ───────────────────────────────────
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Firebase service account key (if saved as file) ───────
*service-account*.json
*firebase-adminsdk*.json

# ── Test suite dependencies (each suite installs its own) ────────────────
selenium-tests/node_modules/
appium-tests/node_modules/
load-tests/node_modules/
security-tests/node_modules/

# tsc emits .js beside the .tsx sources during `pnpm --filter @mediguard/web build`
# (the web tsconfig has no noEmit). Those are build output, not source.
apps/web/src/**/*.js
apps/mobile/src/**/*.js
